---
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '../utils/date';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
  lang?: string;
}

const { title, description, pubDate, tags = [], lang = 'en' } = Astro.props;

const formattedDate = formatDate(pubDate, 'long');
---

<BaseLayout title={`${title} | Roger Deng`} description={description} lang={lang} backLink={{ label: "← Back", href: "/blog" }}>
  <main class="container">
    <section class="hero">
      <div class="blog-post-header">
        <h1>{title}</h1>
        <p class="meta"><time datetime={pubDate.toISOString()}>{formattedDate}</time></p>
        {tags.length > 0 && (
          <div class="tech-tags" style="margin-top:8px;">
            {tags.map((tag) => <span>{tag}</span>)}
          </div>
        )}
      </div>
    </section>
    <article class="blog-post-content">
      <slot />
    </article>
  </main>
</BaseLayout>
