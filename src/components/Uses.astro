---
import { usesCategories, usesUpdated } from '../data/uses';
---

<section id="uses" class="section">
  <div class="section-header">
    <h2>Uses</h2>
    <p class="section-note">Tools and setup I use daily.</p>
  </div>
  <div>
    {usesCategories.map((cat) => (
      <div style="margin-bottom: 28px;">
        <p class="card-label">{cat.title}</p>
        <div class="uses-icon-grid">
          {cat.items.map((item) => (
            <div class="uses-icon-item">
              {item.svg === 'codex' ? (
                <svg class="uses-custom-icon" width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="4" stroke="currentColor" stroke-width="1.8"/><path d="M9 9l-3 3 3 3M15 9l3 3-3 3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              ) : item.svg === 'vscode' ? (
                <svg class="uses-custom-icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23.15 2.587 18.21.21a1.494 1.494 0 0 0-1.705.29l-9.46 8.63-4.12-3.128a.999.999 0 0 0-1.276.057L.327 7.261A1 1 0 0 0 .325 8.74L3.899 12 .325 15.26a1 1 0 0 0 .002 1.479L1.65 17.94a.999.999 0 0 0 1.276.057l4.12-3.128 9.46 8.63a1.492 1.492 0 0 0 1.704.29l4.942-2.377A1.5 1.5 0 0 0 24 20.06V3.939a1.5 1.5 0 0 0-.85-1.352zm-5.146 14.861L10.826 12l7.178-5.448v10.896z"/></svg>
              ) : (
                <img
                  src={`https://cdn.simpleicons.org/${item.icon}/${item.color}`}
                  alt={item.name}
                  width="18"
                  height="18"
                  loading="lazy"
                />
              )}
              <span>{item.name}</span>
            </div>
          ))}
        </div>
      </div>
    ))}
    <p class="meta">Last updated: {usesUpdated}</p>
  </div>
</section>
