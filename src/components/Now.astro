---
import { nowItems, nowUpdated } from '../data/now';
---

<section id="now" class="section">
  <div class="section-header">
    <h2>Now</h2>
    <p class="section-note">What I'm focused on at this point in time.</p>
  </div>
  <div class="focus-summary">
    <ul class="now-list">
      {nowItems.map((item) => (
        <li class="now-item">{item.label} — {item.text}</li>
      ))}
    </ul>
    <p class="meta" style="margin-top: 16px;">Last updated: {nowUpdated}</p>
  </div>
</section>
