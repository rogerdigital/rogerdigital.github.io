---
import { getCollection } from 'astro:content';
import { formatDate } from '../utils/date';

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(({ data }) => !data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---

<section id="writing" class="section">
  <div class="section-header">
    <h2>Writing</h2>
    <p class="section-note">Thoughts on engineering, AI, and tools.</p>
  </div>
  {posts.length === 0 ? (
    <div class="card">
      <p>Coming soon.</p>
    </div>
  ) : (
    <div>
      {posts.map((post) => (
        <div class="writing-item">
          <h3><a href={`/blog/${post.id}`}>{post.data.title}</a></h3>
          <p>{post.data.description}</p>
          <p class="writing-meta"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time></p>
        </div>
      ))}
      <div style="margin-top:12px;">
        <a href="/blog" class="accent-link">All posts →</a>
      </div>
    </div>
  )}
</section>
