---
import BaseLayout from '../layouts/BaseLayout.astro';
import { nowItems, nowUpdated } from '../data/now';
---

<BaseLayout
  title="Now | Roger Deng"
  description="What Roger Deng is focused on right now."
  backLink={{ label: "← Back", href: "/" }}
>
  <main class="container">
    <section class="hero">
      <h1>Now</h1>
      <p class="subtitle">What I'm focused on at this point in time.</p>
    </section>

    <section class="section">
      <div class="focus-summary">
        <ul class="now-list">
          {nowItems.map((item) => (
            <li class="now-item">{item.label} — {item.text}</li>
          ))}
        </ul>
        <p class="meta" style="margin-top:16px;">Last updated: {nowUpdated}</p>
      </div>
      <div style="margin-top:20px;">
        <p class="meta">Inspired by <a href="https://nownownow.com" target="_blank" rel="noreferrer" style="text-decoration:underline;text-underline-offset:3px;">nownownow.com</a></p>
      </div>
    </section>
  </main>
</BaseLayout>
